<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: a blank splash in the app's colour; the shovel animation plays inside the app. -->
    <style name="Theme.Shovel" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0B1320</item>
        <item name="android:navigationBarColor">#07101C</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/shovel_splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/shovel_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
