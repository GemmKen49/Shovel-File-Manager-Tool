<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own start-up splash; this plays the shovel animation inside it. -->
    <style name="Theme.Shovel" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0B1320</item>
        <item name="android:navigationBarColor">#07101C</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">#0B1625</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
</resources>
